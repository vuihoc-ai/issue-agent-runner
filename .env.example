# Copy this file to .env and fill in the values. .env is gitignored.

# --- Jira (the work-item source) ---
# Your Jira Cloud site base URL (no trailing slash).
JIRA_BASE_URL=https://your-org.atlassian.net
# The account email used for Basic auth.
JIRA_EMAIL=you@example.com
# A Jira Cloud API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token

# --- GitHub (where the draft PR is opened) ---
# Target repository as "owner/name". Authentication is handled by the `gh` CLI
# (run `gh auth login` once); no GitHub token is read by this tool.
GITHUB_REPO=your-org/your-repo

# --- Agent backend (the one swappable seam) ---
# Shell command that runs your coding agent inside the cloned repo. The runner
# exposes the task via TASK_KEY / TASK_SUMMARY / TASK_DESCRIPTION env vars and
# the full task as JSON on stdin. Start with the demo backend:
AGENT_CMD=./examples/echo_agent.sh

# --- VCS defaults ---
# Base branch the draft PR targets.
DEFAULT_BRANCH=main
